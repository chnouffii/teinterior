# Copier en `.env` pour le développement, ou définir ces variables au moment du
# build sur le serveur. Vite ne lit que les variables préfixées par VITE_.

# Clé Web3Forms — reçoit les demandes de devis et d'estimation par email.
# Créer un compte gratuit sur https://web3forms.com puis coller la clé ici.
# Sans cette clé, les formulaires refusent l'envoi et invitent à téléphoner,
# plutôt que d'afficher une fausse confirmation.
VITE_WEB3FORMS_KEY=

# Le panel d'administration est inclus par défaut : l'authentification est côté
# serveur et le build ne contient aucun secret. Mettre `false` uniquement pour
# produire un site strictement public, sans le code du panel.
VITE_ENABLE_ADMIN=
